Python Exercise: RNA Sequence Nucleotide Counter & GC Calculator

# Define the input RNA sequence
rna_sequence = "GGGAAAUCCCUUUAGGG"

# Count individual nucleotide occurrences
count_A = rna_sequence.count("A")
count_U = rna_sequence.count("U")
count_G = rna_sequence.count("G")
count_C = rna_sequence.count("C")

# Calculate sequence lengths and GC content metrics
total_length = len(rna_sequence)
total_gc_count = count_G + count_C
gc_percentage = (total_gc_count / total_length) * 100

# Print clean, readable output to the console
print("=== RNA Analysis Results ===")
print(f"Sequence Analyzed : {rna_sequence}")
print(f"Sequence Length   : {total_length} bases\n")

print("--- Nucleotide Counts ---")
print(f"Adenine (A)       : {count_A}")
print(f"Uracil (U)        : {count_U}")
print(f"Guanine (G)       : {count_G}")
print(f"Cytosine (C)      : {count_C}\n")

print("--- Composition Metrics ---")
print(f"Total GC Count    : {total_gc_count}")
print(f"GC Percentage     : {gc_percentage:.2f}%")
print("============================")
